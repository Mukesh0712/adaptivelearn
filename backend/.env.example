# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017/adaptivelearn
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adaptivelearn
MONGODB_URI=mongodb://127.0.0.1:27017/adaptivelearn

# Frontend URL allowed by CORS (in production: https://your-domain)
CLIENT_ORIGIN=http://localhost:5174
# Production only: number of proxies in front of the app (1 on Render/Railway)
TRUST_PROXY=1
# Optional: Umami analytics host, allowed by the Content-Security-Policy
# ANALYTICS_ORIGIN=https://cloud.umami.is

# JWT secret for access tokens (min 32 chars). Generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m

# JWT secret for refresh tokens: must be DIFFERENT from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=replace-with-another-long-random-string-at-least-32-chars
# Session length without "Remember me" (cookie is also cleared when the browser closes)
REFRESH_TOKEN_TTL=1d
# Session length with "Remember me" ticked
REMEMBER_ME_TTL=30d

# Forgot password: how long a reset link stays valid
PASSWORD_RESET_TTL_MINUTES=30

# Email via Gmail SMTP (optional; without SMTP_USER/SMTP_PASS reset links are
# printed in the backend console in development).
# SMTP_PASS must be a Gmail App Password (needs 2-Step Verification):
#   Google Account > Security > 2-Step Verification > App passwords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM="AdaptiveLearn <your.address@gmail.com>"

# Admin account created by `npm run seed:admin` (admins can't self-register).
# Wrap values containing # in double quotes: ADMIN_PASSWORD="abc#123" (# starts a comment).
# Changed the password later? Run: npm run seed:admin -- --reset-password
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@adaptivelearn.local
ADMIN_PASSWORD=change-me-strong-password
