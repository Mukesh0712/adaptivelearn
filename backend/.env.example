# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017/adaptivelearn
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adaptivelearn
MONGODB_URI=mongodb://127.0.0.1:27017/adaptivelearn

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5174

# JWT secret for access tokens (min 32 chars). Generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL=15m

# JWT secret for refresh tokens: must be DIFFERENT from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=replace-with-another-long-random-string-at-least-32-chars
REFRESH_TOKEN_TTL=7d

# Admin account created by `npm run seed:admin` (admins can't self-register).
# Wrap values containing # in double quotes: ADMIN_PASSWORD="abc#123" (# starts a comment).
# Changed the password later? Run: npm run seed:admin -- --reset-password
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@adaptivelearn.local
ADMIN_PASSWORD=change-me-strong-password
