# Copy this file to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# Local:  mongodb://127.0.0.1:27017/adaptivelearn
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/adaptivelearn
MONGODB_URI=mongodb://127.0.0.1:27017/adaptivelearn

# Frontend URL allowed by CORS
CLIENT_ORIGIN=http://localhost:5174
