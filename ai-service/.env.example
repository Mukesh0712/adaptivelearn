# Copy this file to .env and fill in real values. Never commit .env.

# development shows the API docs at /docs; production hides them.
APP_ENV=development

# Shared secret: the Node backend sends it in the X-Internal-Key header and
# this service refuses every request without it. Must be at least 32
# characters and EXACTLY the same as AI_SERVICE_SECRET in backend/.env.
# Generate one in PowerShell:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_SERVICE_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Which AI model answers. "mock" gives fixed sample answers without any
# API key, for building and testing. Real providers are added later.
AI_PROVIDER=mock
