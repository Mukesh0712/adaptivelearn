# Frontend build settings. Everything here is PUBLIC: VITE_* values are
# embedded in the JavaScript sent to every visitor. Never put secrets here.
# Copy to .env.production (or set in your hosting dashboard) for real builds.

# Public address of the site, used for social previews, sitemap and robots.txt
VITE_SITE_URL=http://localhost:5174

# Umami analytics (cookieless). Leave empty to disable analytics.
# From your Umami dashboard: Websites > Edit > Tracking code
VITE_UMAMI_SRC=
VITE_UMAMI_WEBSITE_ID=
